# MiniRAG 项目根目录 .gitignore

# Docker
.dockerignore
docker-compose.override.yml

# 环境变量
.env
.env.*
.env.local
.env.production

# 日志文件
*.log
logs/

# 临时文件
temp/
tmp/
.cache/
*.bak

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Vim
*~

# 数据库数据 (如果不希望提交到git)
pg_data/
redis_data/

# 上传文件
uploads/*
!uploads/.gitkeep

# 构建产物
frontend/dist/
backend/build/

# Python
venv/
env/
ENV/
*.pyc
__pycache__/

# codex
.codex
